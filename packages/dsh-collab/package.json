{
  "name": "@dsh-llsa/collab",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "DSH managed collaboration with adaptive compact messages and immutable step history",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./protocol": "./src/protocol.js",
    "./store": "./src/store.js",
    "./manager": "./src/manager.js",
    "./computation": "./src/computation.js",
    "./encoding-policy": "./src/encoding-policy.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24.11.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "js-tiktoken": "1.0.21",
    "zod": "4.4.3"
  },
  "author": "DSH-LLSA contributors",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "typescript": "6.0.3",
    "@types/node": "24.10.1"
  }
}
