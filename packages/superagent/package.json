    "src",
    "lib",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsdown",
    "test": "node --experimental-transform-types --test test/*.test.js"
  },
